{
  "name": "group-ai-os-whatsapp",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp Cloud API communication module for Group AI OS (Phase 1: Bed Janssen)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "migrate": "tsx src/platform/db/migrate.ts",
    "worker": "tsx src/worker.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fastify/sensible": "^6.0.7",
    "fastify": "^5.12.7",
    "jose": "^6.2.14",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
