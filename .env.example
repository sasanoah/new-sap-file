# --- Database -----------------------------------------------------------
# Migrations run as the schema owner; the app connects as wa_app (RLS enforced).
DATABASE_OWNER_URL=postgres://postgres:postgres@localhost:5432/group_ai_os
DATABASE_URL=postgres://wa_app:change-me@localhost:5432/group_ai_os

# --- Outbound safety switch --------------------------------------------
# disabled (default) | dry_run | live. Only "live" ever calls Meta, and only for
# accounts that passed verification and were enabled by a platform admin.
WHATSAPP_OUTBOUND_MODE=disabled
GRAPH_API_BASE_URL=https://graph.facebook.com

# --- Credential encryption ---------------------------------------------
# 32 random bytes, base64: openssl rand -base64 32. Store in your secret manager.
CREDENTIALS_MASTER_KEY=
CREDENTIALS_KEY_ID=k1
# After rotation: CREDENTIALS_PREVIOUS_KEYS=k1:<old base64 key>

# --- Staff authentication (group identity provider) -------------------
AUTH_ISSUER=https://idp.example.com/
AUTH_AUDIENCE=group-ai-os
AUTH_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# Local development only (rejected when NODE_ENV=production):
# AUTH_HS256_SECRET=

# --- AI assistant (optional; off per phone number by default) -----------
# ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_MIN_CONFIDENCE=0.7

# --- Campaign limits ---------------------------------------------------
CAMPAIGN_MAX_RECIPIENTS=1000
CAMPAIGN_SEND_INTERVAL_MS=1000
